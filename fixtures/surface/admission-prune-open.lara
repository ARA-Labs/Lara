artifact admission_prune_open at sha256:admission-prune-open
policy surface-policy
use backends []

claim claim-main
  nl      = "admission-pruned open obligation"
  formal  = score(7)
  binding = { author = author, rationale = "obligation witness", audit-status = reviewed }

leaf keep : evidence(7)
  kind       = observed
  provenance = user
  refs       = []

leaf drop : evidence(7)
  kind       = certified
  provenance = user
  refs       = []

arg arg-open : supports(claim-main) by pass from [keep]
  open cq

arg arg-pruned : supports(claim-main) by pass from [drop]
  open cq
