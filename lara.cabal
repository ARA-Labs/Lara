cabal-version:      3.0
name:               lara
version:            0.1.0.0
synopsis:           Experimental LP adapter seed for the LARA claim-support checker
description:        The current package checks explicit Logic-of-Proofs derivations and
                    is retained as an experimental optional strict adapter. It is not yet
                    LARA's trusted core: the backend registry, natural-deduction reference
                    adapter, claim-support calculus, and grounded argumentation layer remain to
                    be implemented.
license:            MIT
license-file:       LICENSE
author:             yfhe
maintainer:         yfhe.prsn@gmail.com
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall -Werror=missing-fields

library
    import:           warnings
    hs-source-dirs:   src
    other-modules:    Lara.Admission.Internal
                      Lara.Driver.Internal
                      Lara.Mutate.Accept.Build
                      Lara.Mutate.Accept.Ops
                      Lara.Mutate.Outcome
                      Lara.Mutate.Seed
                      Lara.Mutate.Sites
                      Lara.Mutate.Sites.Cert
                      Lara.Mutate.Sites.Conflict
                      Lara.Mutate.Sites.Localize
                      Lara.Mutate.Sites.Nav
    exposed-modules:  Lara.Prop
                      Lara.Strict
                      Lara.Strict.Cell
                      Lara.Strict.ND
                      Lara.Strict.ND.Internal
                      Lara.Strict.Ord
                      Lara.Strict.RA
                      Lara.AST
                      Lara.Sigma
                      Lara.Sigma.WellSorted
                      Lara.Admission
                      Lara.Replay
                      Lara.Syntax
                      Lara.Elaborate
                      Lara.Elaborate.Internal
                      Lara.Elaborate.Error
                      Lara.Elaborate.CertSlots
                      Lara.Elaborate.FormulaNames
                      Lara.Elaborate.NDNamed
                      Lara.Elaborate.SlotNames
                      Lara.Elaborate.Subst
                      Lara.Elaborate.Comparison
                      Lara.Elaborate.ValueBinding
                      Lara.Examples
                      Lara.Negatives
                      Lara.Term
                      Lara.Formula
                      Lara.ConstantSpec
                      Lara.Kernel
                      Lara.Wire
                      Lara.Policy
                      Lara.SupportTerm
                      Lara.SupportTerm.Internal
                      Lara.Attack
                      Lara.Compile
                      Lara.Compile.Internal
                      Lara.Grounded
                      Lara.Semantics
                      Lara.Update
                      Lara.Runtime
                      Lara.Check
                      Lara.Blocked
                      Lara.Check.Internal
                      Lara.Reporting
                      Lara.Diagnostics
                      Lara.Driver
                      Lara.ExpectedJson
                      Lara.Mutate
                      Lara.Mutate.Accept
                      Lara.Mutate.Codec
                      Lara.Mutate.Cycle
                      Lara.Mutate.Manifest
                      Lara.Mutate.Sorts
                      Lara.Mutate.Suite
                      Lara.Measure
                      Lara.ClaimSupport
                      Lara.BindingAudit
                      Lara.BindingAudit.Tsv
                      Lara.BindingAudit.Types
                      Lara.AtomicWrite
                      Lara.ClaimSupport.Load
                      Lara.MechReview
                      Lara.MechReview.Load
                      Lara.RunningExample
                      Lara.WorkedExamples
    build-depends:    base >=4 && <5
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
                    , unix
    default-language: GHC2021

executable lara
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >=4 && <5
                    , bytestring
                    , filepath
                    , lara
    default-language: GHC2021

executable lara-bench
    import:           warnings
    hs-source-dirs:   scripts
    main-is:          bench.hs
    ghc-options:      -O2
    build-depends:    base >=4 && <5
                    , bytestring
                    , directory
                    , filepath
                    , lara
                    , process
    default-language: GHC2021

test-suite lara-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    SigmaFixture
                      CorpusUnitsSpec
                      AdmissionSpec
                      BindingAuditSpec
                      Lara.AdmissionFixture
                      ClaimSupportSpec
                      MechReviewSpec
                      RunningExampleSpec
                      PropSpec
                      ReplaySpec
                      TestReplay
                      StrictSpec
                      RASpec
                      OrdSpec
                      WireSpec
                      SyntaxSpec
                      ThetaInferenceSpec
                      CertSlotsSpec
                      NDNamedSpec
                      ValueBindingsSpec
                      ElaborateSpec
                      WorkedExamplesSpec
                      SurfaceRewriteSpec
                      CheckSpec
                      BlockedSpec
                      DifferentialSpec
                      MutationSpec
                      MeasureSpec
                      AblationSpec
                      RuntimeSpec
                      ReportingSpec
                      CliSpec
                      FormulaNamesSpec
                      SlotNamesSpec
                      SemanticsSpec
                      UpdateSpec
                      TestAF
    build-depends:    base >=4 && <5
                    , lara
                    , aeson
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
                    , unix
                    , QuickCheck
    build-tool-depends: lara:lara
    default-language: GHC2021
