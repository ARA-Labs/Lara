# A member that declares a located hole BEFORE its complete argument: `ph` is a
# controlled_experiment instance that leaves the mandatory external_validity
# question open, so it type-checks with obligations [external_validity] and is
# not an AF node (lara-core@0.3, spec §4.4). `pa` is the complete argument for
# the same claim. In the linked unit `ph` sits at declaration position 0 and
# `pa` at position 1, but `pa` is AF node 0 — the case map-verdict@2's AF index
# space exists for.
artifact paper_pos at sha256:pos...
policy empirical-v1
use backends [nd@1]

claim c_pos
  nl      = "Method M improves accuracy on distribution D"
  formal  = improves(M, accuracy, D)
  binding = { author = alice, audit-status = reviewed }

leaf a_e1 : reports(paperA_exp1, effect(M, accuracy, D, positive))
  kind       = observed
  provenance = ai-executed
  refs       = [paperA/table_2.csv#row=mean]

leaf a_e2 : randomized(paperA_exp1)
  kind       = attested
  provenance = user
  refs       = [paperA.pdf#sec=4]

leaf a_e3 : powered(paperA_exp1)
  kind       = attested
  provenance = user
  refs       = [paperA.pdf#sec=4]

leaf a_e4 : generalizes(M, accuracy, D)
  kind       = attested
  provenance = user
  refs       = [paperA.pdf#sec=5]

arg ph : supports(c_pos) by controlled_experiment(M, accuracy, D, paperA_exp1)
  discharge randomization     with a_e2
  discharge adequate_power    with a_e3
  open      external_validity

arg pa : supports(c_pos) by controlled_experiment(M, accuracy, D, paperA_exp1)
  discharge randomization     with a_e2
  discharge adequate_power    with a_e3
  discharge external_validity with a_e4

status c_pos
