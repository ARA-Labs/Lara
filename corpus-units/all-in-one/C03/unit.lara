#
# Expected verdict is at the bottom of this file (golden oracle).

artifact all-in-one at sha256:62b9c8db2538
policy corpus-v1
use backends [nd@1]

# --- The headline claim, stated but not assemblable at corpus-v1's evidential bar --------------

claim c03
  nl      = "Simformer accurately estimates all arbitrary conditionals of the joint: mean C2ST over 100 sampled conditionals stays below 0.7 on Tree, HMM, Two Moons, and SLCP at 1e5 sims"
  formal  = generalizes_to(accurate_conditional_estimation, arbitrary_conditionals)
  binding = { author = m0-annotator, audit-status = unreviewed }

# --- Evidence leaves are present ... ------------------------------------------------------------

# Principal premise: E02's per-task mean-C2ST cells over the 100 sampled conditionals, per result
# cell in the annotation and folded into refs.
leaf e1 : reports(e02, instances(accurate_conditional_estimation, arbitrary_conditionals, positive))
  kind       = observed
  provenance = ai-executed
  refs       = [logic/experiments.md#E02, Fig-4b, trace/exploration_tree.yaml#N09]

leaf e2 : valid_instances(e02)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E02-Setup, logic/experiments.md#E02-Expected-outcome]

# --- ... but no complete argument is declarable -------------------------------------------------

# (Intentionally no `arg`: representative_sample(e02, arbitrary_conditionals) has no honest leaf —
# 100 sampled conditionals do not warrant the universal over all arbitrary conditionals — and
# corpus-v1 makes that obligation mandatory. Complete support is empty.)

status c03

