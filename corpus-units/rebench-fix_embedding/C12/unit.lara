  provenance = ai-executed
  refs       = [logic/claims.md#C12, logic/experiments.md#E10, logic/experiments.md#E16, logic/experiments.md#E19, logic/experiments.md#E21, trace/exploration_tree.yaml#N312-N313, trace/exploration_tree.yaml#N603-N608, evidence/tables/malt_attempts.md]

# instrument_validity: the 180 s ceiling (attested from the scorer source citation) plus the
# run-5 invalidSubmission payload (observed) — CQ1 and CQ5 both met, folded here.
leaf e2 : valid_instrument(timeout_checkpoint_pathology, cross_run_scoring)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/problem.md#50-51, trace/exploration_tree.yaml#N312, evidence/tables/malt_attempts.md#run-345746-row-13]

# --- ... but no complete argument is declarable -------------------------------------------------

# (Intentionally no `arg`: coverage/covers_scope(cross_run_scoring, fix_embedding_scoring) has no
