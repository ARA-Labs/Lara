# Expected verdict is at the bottom of this file (golden oracle).

artifact rebench-fix_embedding at sha256:db4bd6019427
policy corpus-v1
use backends [nd@1]

# --- The headline claim, stated but not assemblable at corpus-v1's evidential bar --------------

claim c12
  nl      = "The scorer 180 s hard timeout interacts pathologically with large checkpoints: a 1.56B-param 3.1 GB fp16 .pth spends about 60 s just deserialising, timeouts cascade within a run (run 11 six in a row), and run 5 computed score 1.291 was discarded as invalidSubmission"
  formal  = holds(timeout_checkpoint_pathology, fix_embedding_scoring)
  binding = { author = m0-annotator, audit-status = unreviewed }

# --- Evidence leaves are present ... ------------------------------------------------------------

# Principal premise: the cross-run timeout observations (E10/E16/E19/E21), per trace node in the
# annotation and folded into refs.
leaf e1 : observes(cross_run_scoring, timeout_checkpoint_pathology, fix_embedding_scoring)
