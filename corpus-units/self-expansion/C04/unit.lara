artifact self-expansion at sha256:aa759bc10299
policy corpus-v1
use backends [nd@1]

# --- The headline claim, stated but not assemblable at corpus-v1's evidential bar --------------

claim c04
  nl      = "SEMA generalises across functional adapter types: swapping the default Adapter for LoRA or Convpass inside the unchanged SEMA framework keeps A_N within about 2% on both ImageNet-A and VTAB (gaps 1.03 and 1.05 on ImageNet-A; LoRA +0.59 and Convpass -0.58 on VTAB)"
