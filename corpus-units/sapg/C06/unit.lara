  provenance = ai-executed
  refs       = [logic/experiments.md#E06-Procedure-step-1]

leaf e3 : matched_protocol(e06)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E06-Setup, logic/experiments.md#E06-Baselines]

# --- ... but no complete argument is declarable -------------------------------------------------

# (Intentionally no `arg`: variance_reported(e06) has no honest leaf — E06 reports final
