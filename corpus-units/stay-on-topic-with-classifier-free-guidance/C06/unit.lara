artifact stay-on-topic-with-classifier-free-guidance at sha256:7d6532a2b09e
policy corpus-v1
use backends [nd@1]

# --- The headline claim, the entropy-reduction conjunct ----------------------------------------

claim c06
  nl      = "Falcon-7b-Base with CFG at gamma=1.5 has mean logit entropy 4.7 vs 5.4 for vanilla on P3 samples and its top-p=0.9 vocabulary overlap with Falcon-7b-Instruct is below 30 percent, so CFG lowers entropy yet differs from instruction tuning; no significance test is run and only one model pair is measured"
  formal  = holds(cfg_lowers_sampling_entropy, falcon7b)
  binding = { author = m0-annotator, audit-status = unreviewed }

# --- Evidence leaves are present ... ------------------------------------------------------------

# Principal premise: E04's per-condition mean-entropy measurement (CFG 4.7 vs vanilla 5.4), per
# result cell, with the sub-30% overlap cell folded into refs.
leaf e1 : observes(e04, cfg_lowers_sampling_entropy, falcon7b)
  kind       = observed
  provenance = ai-executed
