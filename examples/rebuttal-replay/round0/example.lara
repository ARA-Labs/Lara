# D1 rebuttal replay — ROUND 0 (submission): the paper alone
#
# Demo of issue #62 (parent #61): a real paper + review + rebuttal exchange encoded as a SEQUENCE
# of three checked programs over ONE artifact under ONE policy (rebuttal-v1). Round 0 is the paper
# as submitted — no reviews yet. The three later rounds add the review attacks (round1) and the
# author's rebuttal (round2); the artifact identity and policy never change, so the per-claim status
# trajectory across rounds is grounded semantics re-adjudicating a growing argument population.
#
# Candidate paper: ara-paperbench `adaptive-pruning` (APT), the natural D1 candidate — its kurtosis
# ablation is single-run, so corpus-v1's mandatory `variance_reported` CQ has no discharging leaf
# and the ablation claim lands `gap` (corpus unit adaptive-pruning/C04). That gap is exactly what
# the rebuttal round (round2) discharges when the author supplies variance runs. The demo carries
# the DEFEASIBLE ablation leg only (no ra@1 arithmetic certificate — that is C04's separate
# concern, orthogonal to the review exchange).
#
# Round 0 claims (three, chosen so the review round has arguments to attack and the rebuttal round
# has a gap to discharge):
#   * c_bench   (benchmark_evaluation) -> justified: APT at 30% sparsity performs competitively with
#     the dense LLaMA2-7B baseline on the OpenLLM average; protocol_fixed + benchmark_valid met, the
#     optional environment_match left open. (benchmark_evaluation has NO variance CQ, so it clears
#     the bar the ablation cannot — the honest split in the real paper.)
#   * c_measure (measurement) -> justified: APT has a low training-memory footprint; instrument +
#     coverage met, optional confound_control open.
#   * c_kurt    (component_ablation) -> gap: removing the kurtosis salience term is critical, but the
#     ablation is single-run and corpus-v1 makes variance_reported mandatory, so NO complete
#     argument is declarable (E2-style gap: the leaves are on the page, no arg binds them).
#
# Lowering rationale is recorded per block; full write-up in docs/demos/d1-rebuttal-replay.md.
# Expected verdict is at the bottom of this file (golden oracle).

artifact adaptive-pruning at sha256:de3685165a53
policy rebuttal-v1
use backends [nd@1]

# ===============================================================================================
# CLAIM c_bench — benchmark performance vs the dense baseline (justified in round 0)
# ===============================================================================================

claim c_bench
  nl      = "APT at 30% sparsity performs competitively with the dense LLaMA2-7B baseline on the OpenLLM four-task average"
  formal  = performs(apt, dense_baseline, openllm_avg)
  binding = { author = apt-authors, audit-status = reviewed }

leaf pb1 : reports(e02, benchmark_result(apt, dense_baseline, openllm_avg, positive))
  kind       = observed
  provenance = ai-executed
  refs       = [logic/experiments.md#E02, Table-4]

leaf pb2 : fixed_protocol(apt, dense_baseline, e02)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E02-Setup, logic/experiments.md#E02-step-3]

leaf pb3 : valid_benchmark(dense_baseline, openllm_avg)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E02-Metrics]

# protocol_fixed + benchmark_valid discharged; environment_match is OPTIONAL and left open (no
# status effect). benchmark_evaluation carries no variance CQ, so this claim clears the bar.
arg a_bench : supports(c_bench) by benchmark_evaluation(apt, dense_baseline, openllm_avg, e02)
  discharge protocol_fixed    with pb2
  discharge benchmark_valid   with pb3
  open      environment_match

# ===============================================================================================
# CLAIM c_measure — low training-memory footprint (justified in round 0)
# ===============================================================================================

claim c_measure
  nl      = "APT trains with a low peak-memory footprint (41.6 percent of the Prune+Distill baseline)"
  formal  = holds(low_memory_footprint, apt)
  binding = { author = apt-authors, audit-status = reviewed }

leaf pm1 : observes(e04, low_memory_footprint, apt)
  kind       = observed
  provenance = ai-executed
  refs       = [logic/experiments.md#E04, Table-10]

leaf pm2 : valid_instrument(low_memory_footprint, e04)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E04-step-2]

leaf pm3 : covers_scope(e04, apt)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E04-Setup]

# instrument_validity + coverage discharged; confound_control is OPTIONAL and left open.
arg a_meas : supports(c_measure) by measurement(low_memory_footprint, apt, e04)
  discharge instrument_validity with pm2
  discharge coverage            with pm3
  open      confound_control

# ===============================================================================================
# CLAIM c_kurt — the kurtosis-salience ablation (gap in round 0: variance CQ unmet)
# ===============================================================================================

claim c_kurt
  nl      = "Removing the kurtosis (outlier-aware) salience term drops the LLaMA2-7B OpenLLM average from 50.0 to 38.1 at 30 percent sparsity, so the kurtosis term is critical for large-LM pruning"
  formal  = contributes(kurtosis_salience, apt_llama2_7b, openllm_avg)
  binding = { author = apt-authors, audit-status = reviewed }

# The paper supplies the ablation premise and the two met CQs, but the ablation is single-run:
# corpus-v1 / rebuttal-v1 make variance_reported MANDATORY, and no honest variance leaf exists.
# An arg with an open mandatory CQ is an IncompleteArgument rejection, so NO arg is declared — the
# claim's complete-support set is empty and it lands `gap` (E2-style; corpus unit C04).
leaf pk1 : reports(e03, ablation_effect(kurtosis_salience, apt_llama2_7b, openllm_avg, positive))
  kind       = observed
  provenance = ai-executed
  refs       = [logic/experiments.md#E03, Table-5, trace/exploration_tree.yaml#N09-N10]

leaf pk2 : isolated(kurtosis_salience, e03)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E03-step-6]

leaf pk3 : matched_protocol(e03)
  kind       = attested
  provenance = ai-executed
  refs       = [logic/experiments.md#E03-step-7]

# (Intentionally no `arg` for c_kurt: variance_reported(e03) has no honest leaf — E03 reports a
# single run — and rebuttal-v1 makes that obligation mandatory. Round 2 supplies the variance runs.)

status c_bench
status c_measure
status c_kurt

# ==============================================================================================
# EXPECTED VERDICT (golden oracle) — verified by test/WorkedExamplesSpec.hs
# ==============================================================================================
# Compiled AF (declaration order): a_bench (0), a_meas (1). No attacks.
#   a_bench (0) -> in    (LIn; unattacked)
#   a_meas  (1) -> in    (LIn; unattacked)
# Claim statuses:
#   c_bench   -> justified  (support a_bench is in)
#   c_measure -> justified  (support a_meas is in)
#   c_kurt    -> gap        (empty complete support: no arg concludes contributes(kurtosis_salience,
#                            apt_llama2_7b, openllm_avg); statusC = Gap iff null claimSupport, spec §8)
#
# Trajectory so far: c_bench justified, c_measure justified, c_kurt gap. Round 1 (reviews) attacks
# the two justified claims; round 2 (rebuttal) reinstates one, concedes one, and discharges the gap.
