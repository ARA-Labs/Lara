# fig:example run 1b — the external-validity question is discharged by e6,
# so a1 is complete; the recorded dead end e4 is declared but not yet lowered
# to an attack, so nothing challenges a1.
#
# This is run 2 without the undercut d1: the empirical claim c1 has complete,
# unattacked support and is justified, and the strict ord@1 step s1 (authored
# in the same current surface as runs 1 and 2) keeps c2 justified. Between
# run 1 (c1 gap) and run 2 (c1 defeated), this run isolates the effect of
# discharging the question before any attack arrives.

artifact paper_17 at sha256:aaaa...
policy empirical-v3
use backends [nd@1, ord@1]

let base_score = 0.71
let ours_score = 0.74

claim c1
  nl      = "Method M improves accuracy on distribution D"
  formal  = improves(M, accuracy, D)
  binding = { author = alice, audit-status = reviewed }

claim c2
  nl      = "The baseline accuracy {base_score} is strictly below {ours_score}"
  formal  = num_lt(base_score, ours_score)
  binding = { author = alice, audit-status = reviewed }

leaf e1 : reports(exp_3, effect(M, accuracy, D, positive))
  kind       = observed
  provenance = ai-executed
  refs       = [evidence/table_2.csv#row=mean]

leaf base : reports(exp_3, score_cell(M0, accuracy, D, base_score))
  kind       = observed
  provenance = ai-executed
  refs       = [evidence/table_2.csv#row=base]

leaf ours : reports(exp_3, score_cell(M, accuracy, D, ours_score))
  kind       = observed
  provenance = ai-executed
  refs       = [evidence/table_2.csv#row=ours]

leaf e2 : randomized(exp_3)
  kind       = attested
  provenance = user
  refs       = [paper_17.pdf#sec=4.1]

leaf e3 : powered(exp_3)
  kind       = attested
  provenance = user
  refs       = [paper_17.pdf#sec=4.1]

leaf e4 : distribution_shift(M, accuracy, D)
  kind       = attested
  provenance = user
  refs       = [paper_17.pdf#sec=7-limitations]

arg s1 : supports(c2) by lt_recheck from [base, ours]
  assurance = cert(ord@1, sha256:empv3-t0, (ordcmp (prem base) (prem ours)))

leaf e6 : generalizes(M, accuracy, D)
  kind       = observed
  provenance = ai-executed
  refs       = [evidence/table_4.csv#row=ood]

arg a1 : supports(c1) by controlled_experiment from [e1]
  discharge randomization     with e2
  discharge adequate_power    with e3
  discharge external_validity with e6

status c1
status c2
