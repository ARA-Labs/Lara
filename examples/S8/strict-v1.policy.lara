# strict-v1 — strict-certificate policy for worked example S8
#
# S8 carries its own copy of S1's policy. Its source program changes only the
# nd@1 certificate spelling: the same premise is cited inside and outside a
# named binder, then lowered to the numeric proof term the backend replays.

policy strict-v1

# --- Signature (spec §2, §3.4; lara-core@0.2, issue #89) -------------------------------------------
# The many-sorted proposition signature the checker enforces as rejection class R2 at stage 2:
# every predicate and constructor symbol this policy's rules and programs may use, with the sort
# of each argument position. `Num` and `Str` are the two built-in base sorts (the sorts of numeric
# and string literals) and are not declarable.
#
# Generated by `scripts/infer-sigma.hs` (union-find over argument occurrences, finest consistent
# partition), then the sorts were given their intended names — the one editorial step, and the
# only one:
#
#   cabal exec -- runghc --ghc-arg=-package --ghc-arg=lara scripts/infer-sigma.hs \
#     examples/S8/strict-v1.policy.lara examples/S8/example.lara

sort Property, Scope

con D : Scope
con safety_invariant : Property

pred holds(Property, Scope)

# A certified citation: the conclusion is a strict (backend-certified)
# consequence of the premise. The premise ≡ conclusion shape is the maximal
# source-level claim the current flat-atom nd@1 encoding can establish; S8's
# redex is presentation-only and neither introduces a new proposition nor
# makes the source premise stronger.
rule certified_citation(X, D)
  mode       = strict
  premises   = [ holds(X, D) ]
  conclusion = holds(X, D)
  allow-trusted = false
  certifiers = [ (nd@1, sha256:strict-v1-theory-0) ]

# The empty theory the certificate cites. The digest is a placeholder like the
# artifact digests (no digest computation exists in the codebase — M4b B0
# investigation, docs/m4b-b0-source-and-replay-bundle.md).
theory sha256:strict-v1-theory-0 = []
